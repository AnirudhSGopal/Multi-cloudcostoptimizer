# Selects the development or production configuration.
FLASK_ENV=production
# Flask CLI import path.
FLASK_APP=wsgi.py

# Generate a unique secret and store it in the host secret manager.
SECRET_KEY=replace-with-a-random-flask-secret
# Generate a separate unique secret for JWT signing.
JWT_SECRET_KEY=replace-with-a-different-random-jwt-secret
# Generate with Fernet.generate_key(); used to encrypt cloud credentials.
ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Legacy compatibility only; use ENCRYPTION_KEY for new deployments.
CLOUD_ENCRYPTION_KEY=replace-with-a-fernet-key-for-legacy-code

# Supabase PostgreSQL URL; use direct/session mode for migrations and a pooler for the app.
# Replace the placeholder with a secret-managed URL before use.
DATABASE_URL=postgresql://user:password@db.example.supabase.co:5432/postgres?sslmode=require
# Isolated database URL used by the test configuration.
TEST_DATABASE_URL=sqlite:///:memory:
# SQLAlchemy pool size for the application.
DB_POOL_SIZE=2
# Extra overflow connections allowed beyond DB_POOL_SIZE.
DB_MAX_OVERFLOW=1
# Seconds to wait for a pooled database connection.
DB_POOL_TIMEOUT=30
# Number of Gunicorn web workers in the production container.
GUNICORN_WORKERS=2
# Celery task soft time limit in seconds.
CELERY_TASK_SOFT_TIME_LIMIT=240
# Celery hard time limit in seconds.
CELERY_TASK_TIME_LIMIT=300
# Socket timeout in seconds when connecting to the Celery broker.
CELERY_BROKER_CONNECTION_TIMEOUT=5
# Number of short retries when publishing a task to an unavailable broker.
CELERY_TASK_PUBLISH_MAX_RETRIES=1

# Redis broker/result backend and rate-limit storage.
REDIS_URL=redis://localhost:6379/0

# Comma-separated frontend origins; use explicit origins, never * in production.
CORS_ORIGINS=https://app.example.com

# Optional admin account email used by the bootstrap script.
ADMIN_EMAIL=admin@example.com
# Optional bootstrap password; replace with a unique secret before running the script.
ADMIN_PASSWORD=replace-with-a-unique-admin-password
# Optional admin account username used by the bootstrap script.
ADMIN_USERNAME=admin

# Optional Gemini API key for AI-backed recommendations.
GEMINI_API_KEY=replace-with-a-gemini-api-key
# Optional Google API key used only by legacy evaluation scripts, not authentication.
GOOGLE_API_KEY=replace-with-a-google-api-key-for-legacy-evaluation-scripts
# Maximum Gemini requests per user per day.
GEMINI_DAILY_USER_QUOTA=25
# Maximum Gemini requests across all users per day.
GEMINI_DAILY_GLOBAL_CAP=500
# Timeout in seconds for Gemini requests.
GEMINI_REQUEST_TIMEOUT_SECONDS=10
# Consecutive Gemini failures before opening the circuit breaker.
GEMINI_CIRCUIT_BREAKER_FAILURES=3
# Seconds before retrying after the Gemini circuit breaker opens.
GEMINI_CIRCUIT_BREAKER_RESET_SECONDS=300
# Optional read-only token used for private repository scans.
GITHUB_TOKEN=replace-with-a-read-only-github-token
# Optional AWS access key for legacy/environment-based integrations.
AWS_ACCESS_KEY_ID=replace-with-an-aws-access-key
# Optional AWS secret key for legacy/environment-based integrations.
AWS_SECRET_ACCESS_KEY=replace-with-an-aws-secret-key
# Optional API key read by legacy evaluation scripts.
API_KEY=replace-with-an-api-key
# Optional database password read by legacy evaluation scripts.
DB_PASSWORD=replace-with-the-database-password

# Base directory for temporary repository clones.
CLONE_BASE_DIR=./instance/repositories
# Maximum repository clone size in megabytes.
MAX_REPO_SIZE_MB=500

# Enables Flask debug mode outside production; keep false for production.
DEBUG=False
# Optional DSN; Sentry is initialized only when set.
SENTRY_DSN=https://public-placeholder@example.ingest.sentry.io/0000000